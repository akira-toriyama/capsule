# Baked images live in ~/.tart and as local .tvm caches — never in git.
*.tvm

# Never commit signing material or keychains. (No step generates these
# anymore — 40-signing-cert.sh was removed in t-4mp3 — but the patterns
# stay as accident insurance for anything a future step drops here.)
*.p12
*.pem
*.keychain
*.keychain-db
.signing-id

# Compiled helpers (bake.sh builds helpers/*.swift on the HOST into
# .build/ — the guest is toolchain-free).
.build/

# Screenshots / AX dumps captured during a verify run.
artifacts/
*.png

# macOS / editor noise.
.DS_Store
